{
  "name": "@evidencekit/numbers",
  "version": "0.1.0",
  "description": "Check that every number in an AI output traces to the evidence it was given, and that rows add up to printed totals, using exact decimal arithmetic. Zero-dependency, framework-agnostic TypeScript.",
  "keywords": [
    "numbers",
    "number-verification",
    "numeric-verification",
    "decimal",
    "bigint",
    "reconciliation",
    "llm",
    "llm-output",
    "hallucination",
    "rag",
    "grounding",
    "fact-checking",
    "finance",
    "extraction",
    "evidence-kit",
    "number-trace-kit"
  ],
  "author": "Lucas Kopietz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evidencekit/numbers.git"
  },
  "homepage": "https://github.com/evidencekit/numbers#readme",
  "bugs": {
    "url": "https://github.com/evidencekit/numbers/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "METHOD.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build",
    "lint": "eslint . --max-warnings=0",
    "audit:dependencies": "npm audit --package-lock-only --include=dev --ignore-scripts --audit-level=low",
    "verify:package": "node scripts/verify-package.mjs",
    "attw": "attw --pack . --ignore-rules cjs-resolves-to-esm",
    "bench": "npm run build && node bench/run.mjs",
    "bench:fetch": "node bench/fetch.mjs",
    "crosscheck": "npm run build && node scripts/crosscheck.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run verify:package",
    "prepublishOnly": "npm run verify"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "10.0.1",
    "eslint": "10.9.1",
    "globals": "17.12.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
